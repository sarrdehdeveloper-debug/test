# Copy to backend/.env (development) or set in your deployment environment.
ZB_ENV=development
ZB_DATABASE_URL=postgresql+psycopg://zodiac:zodiac@localhost:5432/zodiac
ZB_SITE_URL=http://localhost:3000
ZB_LOCALES=["en","ar"]
ZB_COOKIE_SECURE=false

# Payments: "fake" (local testing page) or "stripe"
ZB_PAYMENT_PROVIDER=fake
ZB_STRIPE_SECRET_KEY=
ZB_STRIPE_WEBHOOK_SECRET=

# AI: "fake" (offline sample text) or "gemini"
ZB_AI_PROVIDER=fake
ZB_GEMINI_API_KEY=

# Email: "console" (writes .eml files to storage/outbox) or "smtp"
ZB_EMAIL_BACKEND=console
ZB_SMTP_HOST=smtp.example.com
ZB_SMTP_PORT=587
ZB_SMTP_USERNAME=
ZB_SMTP_PASSWORD=
ZB_SMTP_STARTTLS=true
ZB_EMAIL_FROM=Zodiac Blend <info@zodiacblend.com>
ZB_EMAIL_REPLY_TO=info@zodiacblend.com

# Storage for generated reports (private) and uploaded media
ZB_STORAGE_DIR=./storage

# Chromium for PDF rendering (leave empty to use Playwright's bundled browser)
ZB_CHROMIUM_EXECUTABLE=

ZB_WORKER_CONCURRENCY=4
